<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.driverkit</key>
	<true/>
	<!-- Debug, Internal and Release configurations, development profile. idVendor must be the STRING "*" to match the
	     development profile; the integer 2655 makes installd reject the app (0xe8008015). The TestFlight configuration
	     uses FavorPrinterDriver-TestFlight.entitlements (integer 2655) for the App Store distribution profile. -->
	<key>com.apple.developer.driverkit.transport.usb</key>
	<array>
		<dict>
			<key>idVendor</key>
			<string>*</string>
		</dict>
	</array>
	<key>com.apple.developer.driverkit.allow-third-party-userclients</key>
	<true/>
</dict>
</plist>
