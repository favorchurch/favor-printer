{
  "name": "favor-printer",
  "version": "0.1.0",
  "private": true,
  "description": "Menu-bar app that turns a USB Zebra printer into a Favor RSVP check-in printer",
  "author": "Favor Church <techteam@favor.church>",
  "homepage": "https://rsvp.favor.church/printer",
  "repository": "github:favorchurch/favor-printer",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview:renderer": "node scripts/preview-renderer.mjs",
    "verify:vendor": "node scripts/verify-vendor.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run --maxWorkers=2",
    "e2e:relay-sim": "node scripts/e2e-relay-sim.mjs",
    "dist": "pnpm build && electron-builder --publish never"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.9",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
